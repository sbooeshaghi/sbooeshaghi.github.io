<VirtualHost *:80>
    ServerName sina.bio
    ServerAlias www.sina.bio
    Redirect permanent / https://sina.bio/
</VirtualHost>

<VirtualHost *:443>
    ServerName sina.bio
    ServerAlias www.sina.bio

    ProxyRequests Off
    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    ProxyPass / http://127.0.0.1:8780/ connectiontimeout=5 timeout=30
    ProxyPassReverse / http://127.0.0.1:8780/

    # Keep the SSLEngine and certificate directives managed by Certbot here.
</VirtualHost>
