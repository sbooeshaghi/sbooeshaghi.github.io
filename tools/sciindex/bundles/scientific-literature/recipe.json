{
  "schema_version": "resource-recipe-v0",
  "id": "scientific-literature",
  "version": 1,
  "identifier_namespaces": {
    "doi": ["identifier_format_valid"],
    "pmid": ["identifier_format_valid"],
    "pmcid": ["identifier_format_valid"],
    "arxiv": ["identifier_format_valid"],
    "google_scholar_cluster": ["identifier_format_valid"],
    "orcid": ["identifier_format_valid"],
    "url": ["identifier_format_valid"],
    "repository": ["identifier_format_valid"],
    "package_registry": ["identifier_format_valid"],
    "local": ["identifier_format_valid"]
  },
  "object_kinds": {
    "work": {
      "identifiers": ["google_scholar_cluster", "url", "local"]
    },
    "publication": {
      "identifiers": ["doi", "pmid", "pmcid", "arxiv", "url", "local"]
    },
    "source_document": {
      "identifiers": ["local", "doi", "repository"]
    },
    "claim": {
      "identifiers": ["local"],
      "verifiers": ["evidence_exact_matches"]
    },
    "person": {
      "identifiers": ["orcid", "local"]
    },
    "software": {
      "identifiers": ["doi", "repository", "package_registry", "local"]
    }
  },
  "connection_patterns": [
    {
      "source": "publication",
      "target": "work",
      "verifiers": ["endpoints_exist"]
    },
    {
      "source": "source_document",
      "target": "publication",
      "verifiers": ["endpoints_exist"]
    },
    {
      "source": "publication",
      "target": "claim",
      "verifiers": ["endpoints_exist", "evidence_exact_matches"]
    },
    {
      "source": "claim",
      "target": "publication",
      "verifiers": ["endpoints_exist", "evidence_exact_matches"]
    },
    {
      "source": "claim",
      "target": "work",
      "verifiers": ["endpoints_exist", "evidence_exact_matches"]
    },
    {
      "source": "publication",
      "target": "person",
      "verifiers": ["endpoints_exist"]
    },
    {
      "source": "publication",
      "target": "software",
      "verifiers": ["endpoints_exist"]
    },
    {
      "source": "claim",
      "target": "software",
      "verifiers": ["endpoints_exist", "evidence_exact_matches"]
    }
  ],
  "source_kinds": {
    "local_text": ["source_exists", "source_hash_matches"],
    "local_pdf": ["source_exists", "source_hash_matches"]
  },
  "verifiers": {
    "identifier_format_valid": "Identifier syntax matches its namespace.",
    "source_exists": "Local source path exists.",
    "source_hash_matches": "Local source content matches its recorded hash.",
    "endpoints_exist": "Connection endpoints exist and use an allowed object-kind pattern.",
    "evidence_exact_matches": "Evidence exact-matches retained local text."
  }
}
