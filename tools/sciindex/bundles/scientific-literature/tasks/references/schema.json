{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbooeshaghi.github.io/schemas/sciindex-references-task.schema.json",
  "title": "sciindex references task candidate",
  "type": "object",
  "required": ["references"],
  "additionalProperties": false,
  "properties": {
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "title", "doi", "year", "status", "claims", "evidence"],
        "additionalProperties": false,
        "properties": {
          "ref": {"type": "string", "minLength": 1},
          "title": {"type": "string"},
          "doi": {"type": "string"},
          "year": {"type": ["integer", "null"]},
          "status": {"type": "string", "enum": ["used", "unused_or_unresolved"]},
          "claims": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["span", "page"],
      "additionalProperties": false,
      "properties": {
        "span": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1}
      }
    }
  }
}
