{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbooeshaghi.github.io/schemas/sciindex-summary-task.schema.json",
  "title": "sciindex summary task candidate",
  "type": "object",
  "required": ["summary", "claims"],
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
