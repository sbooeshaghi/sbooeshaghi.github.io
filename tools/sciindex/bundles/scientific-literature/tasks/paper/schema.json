{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sbooeshaghi.github.io/schemas/sciindex-paper-task.schema.json",
  "title": "sciindex paper task candidate",
  "type": "object",
  "required": ["paper", "references"],
  "additionalProperties": false,
  "properties": {
    "paper": {
      "type": "object",
      "required": ["title", "doi", "year", "statement", "evidence"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "doi": { "type": "string" },
        "year": { "type": ["integer", "null"] },
        "statement": { "type": "string" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "title", "doi", "year", "status", "statement", "evidence"],
        "additionalProperties": false,
        "properties": {
          "ref": { "type": "string" },
          "title": { "type": "string" },
          "doi": { "type": "string" },
          "year": { "type": ["integer", "null"] },
          "status": {
            "type": "string",
            "enum": ["used", "unused_or_unresolved"]
          },
          "statement": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["span", "page"],
      "additionalProperties": false,
      "properties": {
        "span": { "type": "string" },
        "page": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
